{
  "cli": {
    "version": ">= 16.31.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "cache": {
        "disabled": true
      },
      "env": {
        "FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT": "120",
        "FASTLANE_XCODE_LIST_TIMEOUT": "120"
      }
    }
  },
  "submit": {
    "production": {}
  }
}